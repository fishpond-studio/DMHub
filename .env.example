# ============================================================
# DMHub 环境变量配置
# 复制此文件为 .env 并填写必填项
# cp .env.example .env
# ============================================================

# ----- 必填 -----
# JWT 签名密钥（生成命令: openssl rand -hex 32）
JWT_SECRET=
# 数据加密密钥（生成命令: openssl rand -hex 32）
ENCRYPTION_KEY=

# ----- 数据库（首次启动引导中配置，也可在此预填） -----
# DB_TYPE 决定 schema 方言；切换后必须重启服务才能生效
# 可选值: postgresql（推荐）/ mariadb / mysql
DB_TYPE=postgresql
# PostgreSQL 示例: postgresql://dmhub:dmhub@postgres:5432/dmhub
# MySQL/MariaDB 示例: mysql://dmhub:dmhub@mysql:3306/dmhub
DATABASE_URL=postgresql://dmhub:dmhub@postgres:5432/dmhub
# TABLE_PREFIX=（已废弃，保留兼容）

# ----- PostgreSQL 容器配置 -----
POSTGRES_USER=dmhub
POSTGRES_PASSWORD=dmhub
POSTGRES_DB=dmhub

# ----- Redis（可选，留空则不启用，使用内存替代） -----
REDIS_URL=

# ----- 邮件（首次启动引导中配置，也可在此预填） -----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ----- OAuth Providers（可选，按需配置） -----
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITLAB_CLIENT_ID=
# GITLAB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DINGTALK_CLIENT_ID=
# DINGTALK_CLIENT_SECRET=
# FEISHU_CLIENT_ID=
# FEISHU_CLIENT_SECRET=

# ----- 自定义 OIDC（可选） -----
# CUSTOM_OIDC_NAME=
# CUSTOM_OIDC_ISSUER=
# CUSTOM_OIDC_CLIENT_ID=
# CUSTOM_OIDC_CLIENT_SECRET=

# ----- 域名（Caddy 自动 HTTPS 用） -----
DOMAIN=dmhub.example.com
