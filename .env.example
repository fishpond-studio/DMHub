# ============================================================
# DMHub 环境变量配置
# 复制此文件为 .env 并填写必填项
# cp .env.example .env
# ============================================================

# ----- 必填 -----
# JWT 签名密钥（生成命令: openssl rand -hex 32）
JWT_SECRET=
# 数据加密密钥（生成命令: openssl rand -hex 32）
ENCRYPTION_KEY=

# ----- 数据库（首次启动引导中配置，也可在此预填） -----
# DB_TYPE 决定 schema 方言；切换后必须重启服务才能生效
# 可选值: postgresql（推荐）/ mariadb / mysql
DB_TYPE=postgresql
# PostgreSQL 示例: postgresql://dmhub:dmhub@postgres:5432/dmhub
# MySQL/MariaDB 示例: mysql://dmhub:dmhub@mysql:3306/dmhub
DATABASE_URL=postgresql://dmhub:dmhub@postgres:5432/dmhub
# TABLE_PREFIX=（已废弃，保留兼容）

# ----- PostgreSQL 容器配置 -----
POSTGRES_USER=dmhub
POSTGRES_PASSWORD=dmhub
POSTGRES_DB=dmhub

# ----- Redis（可选，启用后验证码/限流/票据共享化；留空使用内存） -----
# docker-compose：redis://redis:6379；也可在团队设置中配置后重启生效
REDIS_URL=

# ----- 邮件（首次启动引导中配置，也可在此预填） -----
# 实际运行以「团队设置 / 引导」写入 team_settings 的配置为准
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ----- OAuth / OIDC -----
# 请在 Web「设置 → OIDC / OAuth2」中配置，写入 oauth_providers 表。
# 环境变量不会被运行时读取。OIDC 登记地址示例：
#   主页 URL:     https://your-domain.com
#   重定向 URL:   https://your-domain.com/oauth/oidc
# 详见 docs/guide/oauth.md

# ----- 域名（Caddy 自动 HTTPS 用） -----
DOMAIN=dmhub.example.com

# ----- 生产 CORS（可选）-----
# ALLOWED_ORIGINS=https://your-domain.com
