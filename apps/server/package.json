{
  "name": "@dmhub/server",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint . --ext .ts",
    "test": "tsc -p ../../packages/shared/tsconfig.json && tsx --test test/*.test.ts",
    "test:sanitize": "tsx --test test/sanitize-html.test.ts",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@dmhub/dns-providers": "workspace:*",
    "@dmhub/shared": "workspace:*",
    "@fastify/cookie": "^10.0.1",
    "@fastify/cors": "^10.1.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.6",
    "@simplewebauthn/server": "^13.3.3",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "dompurify": "^3.4.17",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.7",
    "ioredis": "^6.0.0",
    "jsdom": "^25.0.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "node-cron": "^3.0.3",
    "nodemailer": "^10.2.0",
    "otpauth": "^9.5.2",
    "postgres": "^3.4.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.4",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "dotenv": "^16.6.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
